DASHSCOPE_API_KEY=sk-xxx
PG_USER=rag
PG_PASSWORD=rag123456
# Generate a unique random value of at least 32 characters for local deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kb_embeddings_hybrid
MILVUS_DIMENSION=1024
MILVUS_SCORE_THRESHOLD=0.20
RAG_QUERY_REWRITE_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_MAX_REWRITES=3
RAG_DENSE_LIMIT=50
RAG_KEYWORD_LIMIT=50
RAG_CANDIDATE_LIMIT=50
RAG_CONTEXT_LIMIT=5
RAG_RRF_CONSTANT=60
RAG_TOKENIZER_PATH=/models/qwen3-embedding-tokenizer/tokenizer.json
RAG_TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B
PADDLEOCR_ENABLED=true
PADDLEOCR_ENDPOINT=http://localhost:8091
PADDLEOCR_TIMEOUT_SECONDS=180
PG_DB=rag_platform
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs
DOCLING_ENABLED=true
DOCLING_ENDPOINT=http://localhost:8090
DOCLING_TIMEOUT_SECONDS=180
DOCLING_MAX_BYTES=52428800
DOCLING_SAMPLE_PAGES=8
DOCLING_SAMPLE_ROWS=200
DOCLING_FALLBACK_TO_TIKA=true
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
RAG_OBSERVABILITY_ENVIRONMENT=docker
RAG_EVALUATION_ENABLED=false
RAGAS_ENDPOINT=http://ragas:8095
GEPA_ENABLED=false
GEPA_ENDPOINT=http://gepa:8096
RAG_EVALUATION_POLL_MS=60000
